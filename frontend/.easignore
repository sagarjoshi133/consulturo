# Exclude items from EAS Build upload context.
# (Falls back to .gitignore when this file is absent.)

# Dependencies are re-installed on EAS builder
node_modules/

# Build / metro caches
.expo/
.expo-shared/
dist/
build/
web-build/
.metro-health-check*

# Logs and temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Generated native folders — EAS prebuilds these fresh
/android/
/ios/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local env overrides (base .env is required and intentionally NOT ignored)
.env.local
.env.*.local
.env.development.local
.env.production.local

# Keys / secrets that must never be uploaded
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
fcm-service-account*.json
*firebase-adminsdk*.json
GoogleService-Info.plist
