{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://urology-pro.preview.emergentagent.com",
        "EXPO_PUBLIC_BACKEND_FALLBACKS": "https://urology-pro.emergent.host"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "node": "20.18.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://urology-pro.emergent.host",
        "EXPO_PUBLIC_BACKEND_FALLBACKS": "https://urology-pro.preview.emergentagent.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "node": "20.18.0"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://urology-pro.emergent.host",
        "EXPO_PUBLIC_BACKEND_FALLBACKS": "https://urology-pro.preview.emergentagent.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "node": "20.18.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
